# =====================================================================
# Environment Variables for Docker Compose
# Copy file này thành .env và thay đổi giá trị cho phù hợp
# KHÔNG commit file .env thật vào git
# =====================================================================

# Database
DB_PASSWORD=YourStrongDBPassword123!

# JWT Secret (tối thiểu 32 ký tự)
JWT_SECRET=YourSuperSecretJwtKeyForProductionMinimum32Characters!
